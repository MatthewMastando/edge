# Copy to .env and adjust. Never commit .env.
# Every variable read by the API, worker, web app or fixture tooling is listed here.
# Values below match `supabase start` defaults for a local project; hosted values come later.

# --- Runtime mode -----------------------------------------------------------
# fixture: no external providers, everything is labeled fixture/recorded (default; CI uses this)
# live:    real adapters (Stage 3+); requires the credentials below
TRW_MODE=fixture
TRW_ENV=development
TRW_LOG_LEVEL=INFO
# Default display timezone for the UI and reports (storage is always UTC)
TRW_DISPLAY_TIMEZONE=America/New_York

# --- Postgres (Supabase local: `supabase start` prints these) ----------------
# asyncpg-style URL used by the API and worker
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct URL used by the migration runner / tests (same DB by default)
DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase (auth + realtime + storage) ------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
# Publishable/anon key printed by `supabase start` (safe for the browser)
SUPABASE_ANON_KEY=
# Service-role key printed by `supabase start` (server only, never shipped to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret used by the API to verify Supabase-issued tokens (server only)
SUPABASE_JWT_SECRET=
# Bucket used by the Supabase Storage Parquet backend (stub in Stage 0)
SUPABASE_STORAGE_BUCKET=market-snapshots

# --- Object storage for Parquet snapshots ------------------------------------
# local: LocalParquetStore rooted at TRW_STORAGE_ROOT (default in dev/fixture mode)
# supabase: SupabaseStorageStore (stub until Stage 3)
TRW_STORAGE_BACKEND=local
TRW_STORAGE_ROOT=.data/parquet
# Where the fixture generator writes / the FixtureAdapter reads
TRW_FIXTURES_ROOT=fixtures/generated

# --- API service -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins allowed by CORS (web dev server)
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Worker service ----------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=60
WORKER_ID=

# --- Web app (Vite exposes only VITE_* to the browser) -----------------------
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# --- LLM provider (Stage 3; leave empty in fixture mode) ---------------------
# recorded: RecordedProvider replays fixtures/recorded/*.json and labels output as demonstration
# openai:   OpenAIResponsesProvider (Stage 3)
LLM_PROVIDER=recorded
OPENAI_API_KEY=
# Model name is a server setting; no default is asserted as verified
OPENAI_MODEL=
LLM_RECORDINGS_ROOT=fixtures/recorded

# --- Budgets (USD, per calendar month) ---------------------------------------
BUDGET_AI_SEARCH_MONTHLY_USD=100
BUDGET_MARKET_DATA_MONTHLY_USD=0

# --- Research limits (spec section 6) ----------------------------------------
RESEARCH_MAX_RETRIEVALS=12
RESEARCH_MAX_EVIDENCE_TOKENS=25000
RESEARCH_MAX_ITERATIONS=6
RESEARCH_MAX_REPAIRS=1
RESEARCH_TIMEOUT_SECONDS=180
RESEARCH_LLM_RESERVE_USD=0.02
RESEARCH_RETRIEVAL_RESERVE_USD=0.01

# --- Market data providers (Stage 3; unset in fixture mode) ------------------
DATABENTO_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Coinbase public market data needs no key; set only if using authenticated endpoints
COINBASE_API_KEY=
COINBASE_API_SECRET=

# --- Research sources (Stage 3) ----------------------------------------------
TAVILY_API_KEY=
FRED_API_KEY=
EIA_API_KEY=
USDA_NASS_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with contact email
SEC_EDGAR_USER_AGENT=
